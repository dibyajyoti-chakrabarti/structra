# Copy to .env.local for development. Only VITE_* values reach the browser, so nothing
# secret belongs in this file.

# Base URL of the backend API, with the trailing /api/
VITE_API_BASE_URL=http://127.0.0.1:8000/api/

# Where this app is served. Used for display only, redirects are decided by the backend.
VITE_FRONTEND_URL=http://localhost:5173

# Public Razorpay key id (test mode while developing)
VITE_RAZORPAY_KEY_ID=

# Optional
VITE_DOCS_URL=/documentation/
VITE_SUPPORT_EMAIL=
