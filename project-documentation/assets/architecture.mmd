%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Segoe UI, Helvetica, Arial, sans-serif", "lineColor": "#4a4a4a", "primaryColor": "#ffffff", "primaryTextColor": "#1a1a1a", "primaryBorderColor": "#4a4a4a", "clusterBkg": "#ffffff", "clusterBorder": "#4a4a4a"}} }%%
flowchart TB
    Browser["Browser"]
    APIGW["API Gateway"]

    subgraph Edge["Edge and Identity (AWS Managed)"]
        direction LR
        CF["CloudFront and OAC"]
        S3[("S3 Private SPA Bundle")]
        Cognito["Cognito User"]
        GitHubOIDC["GitHub OIDC"]
        CF --> S3
        Cognito --> GitHubOIDC
    end

    subgraph Async["Asynchronous Evaluation"]
        direction LR
        SQS["SQS Eval queue"]
        Worker["Worker Lambda"]
        DLQ["DLQ"]
        SQS --> Worker
        SQS -.-> DLQ
    end

    Bedrock["<b>Bedrock</b><br/>Llama 3.3 70B · us-east-1"]

    subgraph VPC["VPC 10.0.0.0/16 · ap-south-1a + 1b"]
        subgraph AppSubnet["Private App Subnet"]
            Backend["<b>Backend Lambda</b><br/>Django + Mangum"]
        end
        subgraph DBSubnet["Private DB Subnet"]
            RDS[("RDS PostgreSQL:5432")]
        end
        subgraph PublicSubnet["Public Subnet"]
            NAT["<b>NAT instance</b><br/>t4g.small · 1b"]
        end
    end

    SSM["<b>SSM Parameter Store</b>"]
    External["Zoho SMTP, Razorpay, Cognito JWKS"]

    %% ── Browser entry points ─────────────────────────────────────────
    Browser --> APIGW
    Browser --> Edge

    %% ── Request path into the VPC ────────────────────────────────────
    APIGW --> Backend
    Backend --> RDS
    Backend --> NAT
    NAT --> External

    %% ── Evaluation path ──────────────────────────────────────────────
    Worker --> Bedrock
    Worker --> APIGW

    %% ── Configuration ────────────────────────────────────────────────
    SSM -.-> Backend

    %% ── Legend colouring ─────────────────────────────────────────────
    %% green  = inside the VPC, no direct internet
    %% orange = internet-facing or egress path
    %% white  = AWS-managed, outside the VPC
    classDef inVpc fill:#ADF0C7,stroke:#4a4a4a,color:#0B2F2B
    classDef egress fill:#F8D3AF,stroke:#4a4a4a,color:#5C2E00
    classDef managed fill:#ffffff,stroke:#4a4a4a,color:#1a1a1a

    class Backend,RDS inVpc
    class APIGW,CF,NAT egress
    class Browser,S3,Cognito,GitHubOIDC,SQS,Worker,DLQ,Bedrock,SSM,External managed

    style AppSubnet fill:#E7E7E7,stroke:#4a4a4a
    style DBSubnet fill:#E7E7E7,stroke:#4a4a4a
    style PublicSubnet fill:#E7E7E7,stroke:#4a4a4a
